# Copy to .env and fill in. .env is local-only and never committed.
# Only the providers you actually use need a key; empty ones are simply unused.

# Primary provider (ADR-001)
DEEPSEEK_API_KEY=

# Fallback providers (ADR-001) — optional
GLM_API_KEY=
DASHSCOPE_API_KEY=

# Local Ollama needs no key; set the URL only if not default (ADR-002)
#OLLAMA_BASE_URL=http://127.0.0.1:11434
