# Copy to .env and fill in. .env is local-only and never committed.
# Only the providers you actually use need a key; empty ones are simply unused.

# Primary provider (ADR-001)
DEEPSEEK_API_KEY=

# Fallbacks (ADR-001)
ZAI_CODING_API_KEY=          # GLM Coding Plan key (z.ai), coding endpoint
DASHSCOPE_API_KEY=           # Alibaba Qwen — optional

# Local Ollama needs no key; set the URL only if not default (ADR-002)
#OLLAMA_BASE_URL=http://127.0.0.1:11434

# Optional: comma-separated API keys required from clients of OUR core (Stage 1).
# Empty = no auth (trusted home Wi-Fi only).
#AMAI_API_KEYS=
